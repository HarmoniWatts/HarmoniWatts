# =========================
# Variables de entorno
# =========================
.env
.env.local
.env.*.local

# =========================
# Dependencias y builds
# =========================
node_modules/
frontend/.angular/
dist/
target/
build/
*.jar
*.war

# =========================
# Python
# =========================
**/__pycache__/
*.py[cod]
*$py.class
*.pyd

.pytest_cache/
.mypy_cache/
.ruff_cache/

venv/
.venv/
env/

# =========================
# Modelos Machine Learning
# =========================
*.pkl
*.joblib
*.h5
*.keras
*.onnx
*.pt
*.pth

# =========================
# Datasets y archivos masivos
# =========================
*.parquet
*.feather

# prediction-service: modelos entrenados y datasets (se montan como volumen)
backend/prediction-service/model/*
backend/prediction-service/data/*
!backend/prediction-service/model/.gitkeep
!backend/prediction-service/data/.gitkeep

# =========================
# Logs y temporales
# =========================
*.log
tmp/
temp/

# =========================
# IDEs y OS
# =========================
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# =========================
# Archivos de extracción (tariff-service)
# =========================
backend/tariff-service/**/*.pdf
backend/tariff-service/**/*.csv
downloads/
output/
cache/

# =========================
# Mongo / Data dumps
# =========================
*.bson
*.archive
dump/

# Snapshots de datos (pg_dump / mongodump) — compartir por ZIP, no por git
docker/snapshots/postgres/*.dump
docker/snapshots/mongo/harmoniwatts/
docker/snapshots/MANIFEST.txt
harmoniwatts-snapshots-*.zip

# Respaldos locales de BD
docker/backups/

# =========================
# Documentación temporal
# =========================
*.borrador
*-borrador.*

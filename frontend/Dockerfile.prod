# Frontend Angular — imagen de producción (build estático servido por nginx).
# La usa el despliegue en Kubernetes (k8s/). Para desarrollo local sigue usándose
# el Dockerfile normal (ng serve con hot reload).

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Configuración "production": usa src/environments/environment.ts (APIs en el mismo origen)
RUN npm run build -- --configuration production

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/harmoniwatts-frontend/browser /usr/share/nginx/html
EXPOSE 8080

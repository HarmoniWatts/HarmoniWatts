APP_NAME=prediction-service
ENVIRONMENT=development

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=harmoniwatts
MONGODB_COLLECTION_PREDICCIONES=predicciones_consumo

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_URI=models:/forecaster/Production

# Consumption Service
CONSUMPTION_SERVICE_URL=http://localhost:8003

# HTTP Client
HTTP_TIMEOUT_SEC=30

# Modelo
HORIZONTE_HORAS=168
MIN_HISTORY_H=504

# Caché
CACHE_TTL_SEC=3600
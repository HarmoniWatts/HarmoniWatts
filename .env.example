# =============================================================================
# Plantilla de variables de entorno - Keycloak + PostgreSQL (HarmoniWatts)
# =============================================================================
# Copiar a .env y reemplazar los placeholders por valores seguros.
# NUNCA subir .env al repositorio (debe estar en .gitignore).
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=keycloak_db
POSTGRES_USER=your_keycloak_db_user
POSTGRES_PASSWORD=your_strong_db_password
POSTGRES_PORT=5432

# ---------- pgAdmin (interfaz gráfica web, opcional) ----------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050

# ---------- Keycloak (admin inicial) ----------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me_strong_password

# ---------- Keycloak (host y puerto) ----------
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KEYCLOAK_HTTP_PORT=8080

# ---------- SMTP (opcional: verificación de correo, reset password) ----------
# Configuración alternativa: Admin Console → Realm Settings → Email
# Ejemplo Gmail: host smtp.gmail.com, port 587, STARTTLS, usuario app password
# Ejemplo Mailtrap (desarrollo): host sandbox.smtp.mailtrap.io, credenciales desde mailtrap.io
KC_SPI_EMAIL_SMTP_HOST=
KC_SPI_EMAIL_SMTP_PORT=587
KC_SPI_EMAIL_SMTP_FROM=noreply@example.com
KC_SPI_EMAIL_SMTP_USER=
KC_SPI_EMAIL_SMTP_PASSWORD=
KC_SPI_EMAIL_SMTP_SSL_ENABLED=false
KC_SPI_EMAIL_SMTP_STARTTLS=true

# ---------- API electrodomésticos (Spring Boot, host) ----------
HW_ELECTRODOMESTICOS_API_PORT=8083

# ---------- IA visión electrodomésticos (APIs en la nube + failover) ----------
# chain = prueba Gemini → OpenAI → Mistral si uno falla/se queda sin cuota
# También puedes forzar uno solo: gemini | openai | mistral
# Guía: docs/VISION-PROVIDERS.md
HW_VISION_PROVIDER=chain
HW_VISION_CHAIN_ORDER=gemini,openai,mistral
HW_VISION_LOW_CONFIDENCE=0.7

# Gemini Flash — 1.º en la cadena (tier gratuito AI Studio)
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
HW_GEMINI_VISION_MODEL=gemini-3.6-flash
HW_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
HW_GEMINI_TIMEOUT_SECONDS=90

# OpenAI GPT — 2.º (gpt-4o-mini; requiere crédito)
# Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
HW_OPENAI_VISION_MODEL=gpt-4o-mini
HW_OPENAI_BASE_URL=https://api.openai.com
HW_OPENAI_TIMEOUT_SECONDS=90

# Mistral Pixtral — 3.º
# Key: https://console.mistral.ai/
MISTRAL_API_KEY=
HW_MISTRAL_VISION_MODEL=pixtral-12b-2409
HW_MISTRAL_BASE_URL=https://api.mistral.ai
HW_MISTRAL_TIMEOUT_SECONDS=90

# ---------- Dashboard (Mongo + microservicios Node/Python) ----------
# Puerto host de Mongo (consumo enriquecido). 27018 evita choque con Mongo local en 27017.
HW_MONGODB_PORT=27018
# Consumption service (FastAPI)
HW_CONSUMPTION_SERVICE_PORT=8001
# Insights service (Node — KPIs, gráfico, recomendaciones mock, top aparatos mock)
HW_INSIGHTS_SERVICE_PORT=7001
# Mongo Express (UI web). Cambiar usuario/clave en .env real.
HW_MONGO_EXPRESS_PORT=8089
HW_MONGO_EXPRESS_USER=admin
HW_MONGO_EXPRESS_PASSWORD=changeme

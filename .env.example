# =============================================================================
# Plantilla de variables de entorno - Keycloak + PostgreSQL (HarmoniWatts)
# =============================================================================
# Copiar a .env y reemplazar los placeholders por valores seguros.
# NUNCA subir .env al repositorio (debe estar en .gitignore).
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=keycloak_db
POSTGRES_USER=your_keycloak_db_user
POSTGRES_PASSWORD=your_strong_db_password
POSTGRES_PORT=5432

# ---------- pgAdmin (interfaz gráfica web, opcional) ----------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050

# ---------- Keycloak (admin inicial) ----------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me_strong_password

# ---------- Keycloak (host y puerto) ----------
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KEYCLOAK_HTTP_PORT=8080

# ---------- SMTP (opcional: verificación de correo, reset password) ----------
# Configuración alternativa: Admin Console → Realm Settings → Email
# Ejemplo Gmail: host smtp.gmail.com, port 587, STARTTLS, usuario app password
# Ejemplo Mailtrap (desarrollo): host sandbox.smtp.mailtrap.io, credenciales desde mailtrap.io
KC_SPI_EMAIL_SMTP_HOST=
KC_SPI_EMAIL_SMTP_PORT=587
KC_SPI_EMAIL_SMTP_FROM=noreply@example.com
KC_SPI_EMAIL_SMTP_USER=
KC_SPI_EMAIL_SMTP_PASSWORD=
KC_SPI_EMAIL_SMTP_SSL_ENABLED=false
KC_SPI_EMAIL_SMTP_STARTTLS=true
